// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  email String @unique
  password String
  name String?
  phoneNumber String?      
  profileImage String?
  role Role @default(STUDENT)
  birthDate DateTime?
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  notificationReads NotificationRead[]
  hostedSessions LiveSession[]
  orders          Order[]
  approvedOrders  Order[] @relation("OrderApprovals")
  contentProgress ContentProgress[]
  refreshTokens RefreshToken[]
}

enum Role {
  STUDENT
  ADMIN
}

model Course {
  id           String        @id @default(uuid())
  title        String
  description  String
  category     CourseCategory? 
  isFree       Boolean       @default(true)
  price        Decimal?      @db.Decimal(10, 2)
  coverImage   String?
  published    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  files        CourseFile[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  orders          Order[]
  subCourses  SubCourse[]
}

enum CourseCategory {
  QURAN       // تجويد / حفظ
  TAFSIR      // تفسير
  FIQH        // فقه
  AQEEDAH     // عقيدة
  ARABIC      // نحو / لغة عربية
  HADITH      // حديث
}

model CourseFile {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  name      String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  cloudinaryPublicId String?

  @@index([courseId])
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveSession {
  id           String            @id @default(uuid())
  title        String
  roomName     String            @unique
  status       LiveSessionStatus @default(SCHEDULED)

  hostId       String
  host         User              @relation(fields: [hostId], references: [id])

  courseId     String?
  course       Course?           @relation(fields: [courseId], references: [id])

  recordingUrl String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
}

enum NotificationType {
  LIVE_SESSION
  ANNOUNCEMENT_LIVE     
  ANNOUNCEMENT_COURSE   
  ANNOUNCEMENT_GENERAL
}

model Notification {
  id        String            @id @default(uuid())
  type      NotificationType
  title     String
  message   String?
  link      String?
  createdAt DateTime          @default(now())
  expiresAt    DateTime?
  scheduledFor DateTime?
  reads     NotificationRead[]
  @@index([expiresAt])
  @@index([scheduledFor])
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum PaymentMethod {
  CARD
  MANUAL
  BANK_TRANSFER
  POSTAL_TRANSFER
}

model Order {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  courseId          String
  course            Course        @relation(fields: [courseId], references: [id])
  amount            Decimal       @db.Decimal(10, 2)
  method            PaymentMethod
  status            OrderStatus   @default(PENDING)

  konnectPaymentRef String?       @unique
  konnectPayUrl     String?

  approvedById      String?
  approvedBy        User?         @relation("OrderApprovals", fields: [approvedById], references: [id])

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?
  transferReference String?

  @@index([status])
  @@index([userId])
}


model SubCourse {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  themes    Theme[]

  @@index([courseId])
}

model Theme {
  id          String    @id @default(uuid())
  subCourseId String
  subCourse   SubCourse @relation(fields: [subCourseId], references: [id], onDelete: Cascade)
  title       String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contents    ContentBlock[]

  @@index([subCourseId])
}

model ContentBlock {
  id        String   @id @default(uuid())
  themeId   String
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  title     String
  body      String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  progress ContentProgress[]

  @@index([themeId])
}

model ContentProgress {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentBlockId String
  contentBlock   ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)
  completedAt    DateTime     @default(now())

  @@unique([userId, contentBlockId])
  @@index([userId])
  @@index([contentBlockId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  family    String   // shared across one rotation chain (one login session/device)
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
}